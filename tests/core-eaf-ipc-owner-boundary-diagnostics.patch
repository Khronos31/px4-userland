diff --git a/src/receiver_engine.cpp b/src/receiver_engine.cpp
index eaf9400..eaf9400 100644
--- a/src/receiver_engine.cpp
+++ b/src/receiver_engine.cpp
@@ -3,6 +3,9 @@
 
 #include <cassert>
 #include <cstddef>
+#if defined(DTV_USERLAND_IPC_DIAGNOSTICS)
+#include <cstdio>
+#endif
 #include <limits>
 
 namespace dtv::userland::detail {
@@ -1157,13 +1160,35 @@ Result<void> ReceiverEngine::prepare_attach_v1(const StreamAttachTicket& ticket) noexcept
     const ReceiverId receiver = receivers_[slot];
     Attachment attachment = attachment_for(pending, pending.stream_reservation);
     attachment.token = ticket.token;
+#if defined(DTV_USERLAND_IPC_DIAGNOSTICS)
+    std::fprintf(stderr,
+                 "PX4_CORE_ATTACH callback=backend.start_capture phase=call epoch=%llu slot=%zu receiver=%u system=%u stream=%llu reservation=%llu\n",
+                 static_cast<unsigned long long>(ticket.epoch), slot,
+                 static_cast<unsigned>(receiver),
+                 static_cast<unsigned>(pending.system),
+                 static_cast<unsigned long long>(ticket.stream_id),
+                 static_cast<unsigned long long>(ticket.reservation));
+#endif
     const auto started = backend_.start_capture(receiver, pending.system);
+#if defined(DTV_USERLAND_IPC_DIAGNOSTICS)
+    std::fprintf(stderr,
+                 "PX4_CORE_ATTACH callback=backend.start_capture phase=return result=%u error=%u\n",
+                 started ? 0U : 1U,
+                 started ? 0U : static_cast<unsigned>(started.error()));
+#endif
     observe_disconnect(slot, started.error());
     Error data_error = Error::OK;
     bool data_attached = false;
     if (started && stream_control_ != nullptr) {
+#if defined(DTV_USERLAND_IPC_DIAGNOSTICS)
+        std::fprintf(stderr,
+                     "PX4_CORE_ATTACH callback=stream_control.attach phase=call client=%llu lease=%llu attachment=%llu receiver=%u system=%u\n",
+                     static_cast<unsigned long long>(attachment.client_id),
+                     static_cast<unsigned long long>(attachment.lease_id),
+                     static_cast<unsigned long long>(attachment.attachment_id),
+                     static_cast<unsigned>(attachment.receiver),
+                     static_cast<unsigned>(attachment.system));
+#endif
         const auto attached = stream_control_->attach(attachment);
+#if defined(DTV_USERLAND_IPC_DIAGNOSTICS)
+        std::fprintf(stderr,
+                     "PX4_CORE_ATTACH callback=stream_control.attach phase=return result=%u error=%u\n",
+                     attached ? 0U : 1U,
+                     attached ? 0U : static_cast<unsigned>(attached.error()));
+#endif
         observe_disconnect(slot, attached.error());
         if (!attached)
             data_error = attached.error();
         else
             data_attached = true;
+    } else {
+#if defined(DTV_USERLAND_IPC_DIAGNOSTICS)
+        std::fprintf(stderr,
+                     "PX4_CORE_ATTACH callback=stream_control.attach phase=skip started=%u present=%u\n",
+                     started ? 1U : 0U, stream_control_ != nullptr ? 1U : 0U);
+#endif
     }
     const Error failure = !started ? started.error() : data_error;
